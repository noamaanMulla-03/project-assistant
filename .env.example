# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=project_assistant

# ── Backend ──────────────────────────────────────────────
# Database URL for asyncpg (SQLAlchemy async format)
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@db:5432/project_assistant

# JWT secrets — generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://frontend:5173

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Ollama Cloud / Host (LLM) ───────────────────────────
# Base URL for Ollama host or cloud endpoint
OLLAMA_BASE_URL=http://localhost:11434
# Optional API Key for authenticated Ollama cloud endpoints
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_NUM_CTX=65536
OLLAMA_NUM_PREDICT=16384
EXTRACTION_CHUNKS_PER_DOC=12
EXTRACTION_POLICY_TOP_K=8
AGENT_MAX_ITERATIONS=10

