# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=project_assistant

# ── Backend ──────────────────────────────────────────────
# Database URL for asyncpg (SQLAlchemy async format)
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@db:5432/project_assistant

# JWT secrets — generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://frontend:5173

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Groq (LLM) ──────────────────────────────────────────
# Get your API key from https://console.groq.com/keys (free tier available)
GROQ_API_KEY=gsk_replace_with_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
# Keep extraction context small to stay within free-tier TPM limits
GROQ_MAX_TOKENS=4096
EXTRACTION_CHUNKS_PER_DOC=8
EXTRACTION_POLICY_TOP_K=5
