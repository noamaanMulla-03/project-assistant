# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=project_assistant

# ── Backend ──────────────────────────────────────────────
# Database URL for asyncpg (SQLAlchemy async format)
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@db:5432/project_assistant

# JWT secrets — generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Use "none" only when frontend and API are on different sites over HTTPS.
# In that case, set CORS_ORIGINS to the exact frontend origin.
REFRESH_COOKIE_SAMESITE=strict

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://frontend:5173

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Ollama Cloud (LLM) ────────────────────────────────
# Get your API key from: https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=your-ollama-cloud-api-key-here
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_NUM_CTX=65536
OLLAMA_NUM_PREDICT=16384
EXTRACTION_CHUNKS_PER_DOC=12
EXTRACTION_POLICY_TOP_K=8
AGENT_MAX_ITERATIONS=10

